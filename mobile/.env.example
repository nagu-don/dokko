# Dokko Mobile — environment variables (loaded by Expo, EXPOSE to the client)
# Only NON-SECRET, PUBLIC configuration belongs here.
# NEVER put backend secrets (JWT_SECRET, DB URIs, payment/gateway/settlement keys)
# in the mobile app. Secrets stay server-side only.

# API base URL the mobile app talks to. When unset the app falls back to:
#   - Development: the host running `expo start` on port 4000 (auto-derived),
#     or http://10.0.2.2:4000 on the Android emulator, or http://localhost:4000.
#   - Production: must be set to a deployed absolute URL.
EXPO_PUBLIC_API_URL=

# (optional) Override the token used for requests — normally handled automatically.
# EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
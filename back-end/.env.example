# ── Core ────────────────────────────────────────────────────────
JWT_SECRET=
MONGO_URI=
GOOGLE_CLIENT_ID=

# ── Prime Admin (auto-created on server start) ─────────────────
# PRIME_ADMIN_ID is auto-populated when the server starts
PRIME_ADMIN_ID=
# Bootstrap password for the prime admin account (used only once on first boot).
# If unset, a random password is generated and printed to the server console.
# Remove this from the environment after the first successful login.
PRIME_ADMIN_BOOTSTRAP_PASSWORD=

# ── Payment Gateway ────────────────────────────────────────────
# Which provider is active: "mock" | "fonepay"
PAYMENT_PROVIDER=mock

# Company bank account — internal use only (DO NOT expose to frontend)
COMPANY_BANK_ACCOUNT=

# ── Field encryption (AES-256-GCM) ─────────────────────────────
# 32-byte base64-encoded key used to encrypt sensitive fields at rest
# (e.g. vendor payout account numbers). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# ── Rate limiting ─────────────────────────────────────────────
# Per-window request limits for sensitive unauthenticated and high-value
# endpoints. Defaults: LOGIN_RATE_LIMIT_MAX=10, ADMIN_LOGIN_RATE_LIMIT_MAX=5,
# REGISTER_RATE_LIMIT_MAX=20, GOOGLE_AUTH_RATE_LIMIT_MAX=20,
# ORDER_PLACEMENT_RATE_LIMIT_MAX=30, ISSUE_REPORT_RATE_LIMIT_MAX=30 — all per
# RATE_LIMIT_WINDOW_MS (default 15 minutes).
LOGIN_RATE_LIMIT_MAX=
ADMIN_LOGIN_RATE_LIMIT_MAX=
REGISTER_RATE_LIMIT_MAX=
# Per-IP limit on the Google OAuth endpoints (POST /api/users/google,
# /api/vendors/google) — retry-friendly for flaky OAuth handshakes.
GOOGLE_AUTH_RATE_LIMIT_MAX=
# Per-authenticated-user limit on order placement (POST /api/orders/place).
ORDER_PLACEMENT_RATE_LIMIT_MAX=
# Per-IP limit on the public issue-report endpoint (POST /api/issues).
ISSUE_REPORT_RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=

# ── Development/test only ──────────────────────────────────────
# Never enable MOCK_PAYMENT_ENABLED in production.
MOCK_PAYMENT_ENABLED=true

# ── Delivery tariff (distance-based) ────────────────────────────
# Delivery charge (NRs), by straight-line distance between the vendor
# and the customer's drop-off, fixed at vendor acceptance.
DELIVERY_CHARGE_0_300M=25
DELIVERY_CHARGE_301_500M=30
DELIVERY_CHARGE_501M_1KM=50
DELIVERY_CHARGE_1_2KM=75
DELIVERY_CHARGE_2_3KM=100
DELIVERY_CHARGE_3_4KM=125
DELIVERY_CHARGE_4_5KM=150
# Maximum delivery distance in km — orders with no eligible vendor
# within this radius end as NO_VENDOR_AVAILABLE.
DELIVERY_MAX_KM=5

# ── CORS allowed origins ───────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Defaults to local dev ports for front-end, admin, and vendor apps.
# Add deployed/staging URLs here (e.g. https://app.dokko.com).
CORS_ORIGINS=

# ── FONEPAY (Dynamic QR) ───────────────────────────────────────
# CONFIGURATION PENDING. Official Fonepay credentials/API parameters are NOT
# documented in this project yet, so NO FONEPAY_* variables exist.
#
# PAYMENT_PROVIDER=fonepay is a VALID selection, but Fonepay is NEVER ready
# until this block is implemented: initiation fails safely and NEVER silently
# falls back to another provider. Add the real FONEPAY_* variables here once
# the official documentation is supplied.
#
# (Example — replace with the actual Fonepay field names after review of docs)
# FONEPAY_MERCHANT_CODE=
#
# ── NEPALPAY / NCHL (legacy reference) ─────────────────────────
# NCHL/NEPALPAY is no longer part of the active payment architecture and is
# intentionally NOT wired into the gateway config. The integration source
# (gateway/nchlApi.js, gateway/nepalpayProvider.js) remains only as a
# reference. Do not rely on NEPALPAY_* variables for the active payment flow.

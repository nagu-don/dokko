# ── Core ────────────────────────────────────────────────────────
JWT_SECRET=
MONGO_URI=
GOOGLE_CLIENT_ID=

# ── Prime Admin (auto-created on server start) ─────────────────
# PRIME_ADMIN_ID is auto-populated when the server starts
PRIME_ADMIN_ID=

# ── Payment Gateway ────────────────────────────────────────────
# Which provider is active: "nepalpay" | "mock"
PAYMENT_PROVIDER=nepalpay

# Company bank account — internal use only (DO NOT expose to frontend)
COMPANY_BANK_ACCOUNT=

# NepalPay (EMVCo QR)
NEPALPAY_MODE=real
NCHL_MERCHANT_ACCOUNT_TEMPLATE=
NCHL_MERCHANT_NAME=DOKKO
NCHL_MERCHANT_CITY=Kathmandu

# Development/test only. Never enable in production.
MOCK_PAYMENT_ENABLED=false
